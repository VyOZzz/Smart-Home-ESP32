# Application Configuration
APP_NAME=IoT Smart Home

# API Keys
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# Gemini Model Configuration
GEMINI_MODEL=gemini-3.1-flash-live-preview
# Notifications use generate_content, which requires a TTS model instead of Live.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Still-image uploads use a multimodal generate_content model, not the Live model.
GEMINI_IMAGE_MODEL=gemini-3.5-flash

# File Paths
CONVERSATION_HISTORY_FILE=data/conversation_history.json
SESSION_HANDLE_FILE=data/session_handle.json
LIGHT_STATE_FILE=data/light_state.json
MUSIC_DIRECTORY=music

# Music Configuration
MUSIC_SIMILARITY_THRESHOLD=0.72

# WebSocket Configuration
WEBSOCKET_PING_INTERVAL=10
WEBSOCKET_RECEIVE_TIMEOUT=30
WEBSOCKET_CONFIG_TIMEOUT=10

# Capture Configuration
SAVE_CAPTURED_IMAGE=False
CAPTURED_IMAGES_DIRECTORY=data/images

# IP camera: fill only in backend/.env after confirming camera brand/model.
# Example syntax only: rtsp://user:password@192.168.1.100:554/<model-specific-path>
HOME_CAMERA_RTSP_URL=
CAMERA_CAPTURE_INTERVAL_SECONDS=0.5
CAMERA_REQUEST_TIMEOUT_SECONDS=2
CAMERA_RECONNECT_INTERVAL_SECONDS=2
CAMERA_MAX_FRAME_BYTES=512000

# MQTT (Docker Compose uses `mqtt`; change to `localhost` only when FastAPI runs natively)
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_CLIENT_ID=smarthome-backend
MQTT_USERNAME=
MQTT_PASSWORD=
# Enable for EMQX/HiveMQ Cloud (normally port 8883). Keep False for local Mosquitto.
MQTT_TLS_ENABLED=False
# Leave blank to use the operating system CA store. Client certificates are optional.
MQTT_TLS_CA_CERT=
MQTT_TLS_CERTFILE=
MQTT_TLS_KEYFILE=
# Never enable this outside isolated development diagnostics.
MQTT_TLS_INSECURE=False
MQTT_COMMAND_TIMEOUT_SECONDS=3

# Independent ESP32 + DHT11 environment node
ENVIRONMENT_DEVICE_ID=esp32-sensor
ENVIRONMENT_SENSOR_ID=room-1
ENVIRONMENT_STALE_AFTER_SECONDS=30
ENVIRONMENT_HISTORY_DB=data/environment_history.db
ENVIRONMENT_HISTORY_MAX_ROWS=10000
