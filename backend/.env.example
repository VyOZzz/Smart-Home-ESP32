# Application Configuration
APP_NAME=IoT Smart Home

# API Keys
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# Gemini Model Configuration
GEMINI_MODEL=gemini-3.1-flash-live-preview
# Notifications use generate_content, which requires a TTS model instead of Live.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Still-image uploads use a multimodal generate_content model, not the Live model.
GEMINI_IMAGE_MODEL=gemini-3.5-flash

# File Paths
CONVERSATION_HISTORY_FILE=data/conversation_history.json
SESSION_HANDLE_FILE=data/session_handle.json
LIGHT_STATE_FILE=data/light_state.json
MUSIC_DIRECTORY=music

# Music Configuration
MUSIC_SIMILARITY_THRESHOLD=0.72

# WebSocket Configuration
WEBSOCKET_PING_INTERVAL=10
WEBSOCKET_RECEIVE_TIMEOUT=30
WEBSOCKET_CONFIG_TIMEOUT=10

# Capture Configuration
SAVE_CAPTURED_IMAGE=False
CAPTURED_IMAGES_DIRECTORY=data/images

# MQTT (use `mqtt` inside Docker; use `localhost` for a local backend)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=smarthome-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_COMMAND_TIMEOUT_SECONDS=3
